{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "module": "es6",
    "allowJs": true,
    "removeComments": false,
    "sourceMap": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "target": "es5",
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strictNullChecks": true,
    "esModuleInterop": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*"
  ]
}
