<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\web.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:57674</SpaProxyServerUrl>
    <UserSecretsId>da0a24cc-86e1-4c57-bdb0-5459e5cdc728</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Must be >= the transitive version pulled in via UsageReporting -> DataUtils (currently 1.21.0),
      otherwise NuGet raises NU1605 (package downgrade) and the resulting binding redirect mess
      surfaces as CS0433 (DefaultAzureCredential exists in both Azure.Core and Azure.Identity).
    -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AnalyticsEngine\Common\UsageReporting\UsageReporting.csproj" />
    <ProjectReference Include="..\web.client\web.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
