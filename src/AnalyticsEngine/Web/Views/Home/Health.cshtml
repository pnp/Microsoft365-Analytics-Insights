@model Web.AnalyticsWeb.Models.HealthDashboard
@using Web.AnalyticsWeb.Models

@{
    ViewBag.Title = "Health";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    static string StatusBadge(string status)
    {
        switch ((status ?? "").Trim().ToLowerInvariant())
        {
            case "healthy": return "badge-success";
            case "degraded": return "badge-warning";
            case "unhealthy": return "badge-danger";
            default: return "badge-secondary";
        }
    }

    static string FreshnessBadge(System.DateTime? utc, double greenMaxHours, double amberMaxHours)
    {
        var mins = HealthDashboard.MinutesAgo(utc);
        if (!mins.HasValue) return "badge-secondary";
        var hours = mins.Value / 60.0;
        if (hours <= greenMaxHours) return "badge-success";
        if (hours <= amberMaxHours) return "badge-warning";
        return "badge-danger";
    }
}

<br />
<h5 class="card-header text-center">Office 365 Advanced Analytics Engine - @Model.BuildLabel - System Health</h5>
<br />

<p class="text-muted">
    A single "is it working?" view. All values are read-only and best-effort - a data-source hiccup greys out
    one card, it never breaks the page. Values are cached for @HealthDashboard.CacheSeconds seconds
    (loaded @Model.LoadedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC). This complements the Azure Monitor
    alert rules (which <em>push</em> when something breaks) - it is the at-a-glance green board.
</p>

@if (!Model.AppInsightsConfigured)
{
    <div class="alert alert-warning">
        <strong>Application Insights is not configured</strong> for this web app
        (<code>AppInsightsConnectionString</code> is empty), so the Import liveness, Exceptions and Component-health
        cards below are unavailable. The Data overview card (from SQL) still works. Configure the connection string to
        enable the App Insights-backed cards - no extra API key is needed, the app's existing Entra credential is reused.
    </div>
}

<!-- ===================== Import liveness ===================== -->
<div class="card mb-4">
    <div class="card-header"><h4 class="mb-0">Import liveness</h4></div>
    <div class="card-body">
        <p class="text-muted">
            Is each importer still looping and finishing its work? A full activity import cycle should complete at
            least once every @HealthDashboard.CycleSlaHours hours - any longer and the backlog grows faster than the
            importer clears it. "Last confirmed cycle" is the <code>FinishedImportCycle</code> custom event (emitted
            today); the per-section rows are the <code>FinishedSectionImport</code> events.
        </p>

        @if (!string.IsNullOrEmpty(Model.LivenessError))
        {
            <div class="alert alert-warning">Couldn't load import liveness: @Model.LivenessError</div>
        }
        else if (Model.AppInsightsConfigured)
        {
            <h6>Last confirmed cycle per job</h6>
            if (Model.LastCyclePerJob.Any())
            {
                <table class="table table-sm">
                    <thead><tr><th>Importer</th><th>Last cycle (UTC)</th><th>Freshness</th><th>Duration</th></tr></thead>
                    <tbody>
                        @foreach (var job in Model.LastCyclePerJob)
                        {
                            <tr>
                                <td><code>@job.JobName</code></td>
                                <td>@(job.LastCycleUtc.HasValue ? job.LastCycleUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                                <td><span class="badge @FreshnessBadge(job.LastCycleUtc, HealthDashboard.CycleSlaHours, HealthDashboard.CycleSlaHours * 2)">@HealthDashboard.HowLongAgo(job.LastCycleUtc)</span></td>
                                <td class="text-muted">@job.Duration</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">No <code>FinishedImportCycle</code> events in the retention window yet. If the importers were only just deployed, wait for the first cycle to complete.</div>
            }

            <h6 class="mt-3">Last run per section</h6>
            if (Model.LastSectionImports.Any())
            {
                <table class="table table-sm">
                    <thead><tr><th>Section</th><th>Importer</th><th>Last run (UTC)</th><th>Freshness</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.LastSectionImports)
                        {
                            <tr>
                                <td>@s.SectionName</td>
                                <td><code>@s.JobName</code></td>
                                <td>@(s.LastRunUtc.HasValue ? s.LastRunUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                                <td><span class="badge @FreshnessBadge(s.LastRunUtc, HealthDashboard.CycleSlaHours, HealthDashboard.CycleSlaHours * 3)">@HealthDashboard.HowLongAgo(s.LastRunUtc)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No <code>FinishedSectionImport</code> events in the retention window yet.</p>
            }

            if (Model.LastHeartbeats.Any())
            {
                <h6 class="mt-3">Importer heartbeats</h6>
                <table class="table table-sm">
                    <thead><tr><th>Job</th><th>Last beat (UTC)</th><th>Freshness</th><th>Last cycle</th><th>Cycle secs</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.LastHeartbeats)
                        {
                            <tr>
                                <td><code>@b.JobName</code></td>
                                <td>@(b.LastBeatUtc.HasValue ? b.LastBeatUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                                <td><span class="badge @FreshnessBadge(b.LastBeatUtc, 0.5, 1)">@HealthDashboard.HowLongAgo(b.LastBeatUtc)</span></td>
                                <td class="text-muted">@b.LastCycleUtc</td>
                                <td class="text-muted">@b.LastCycleDurationSeconds</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small mt-2">
                    <em>Independent-timer <code>ImporterHeartbeat</code> events are not being emitted yet</em> (that host is a
                    later phase). Until then, "Last confirmed cycle" above is the liveness signal - note it only fires when a
                    cycle <em>completes</em>, so a job stuck mid-cycle would still look recent.
                </p>
            }
        }
    </div>
</div>

<!-- ===================== Exceptions overview ===================== -->
<div class="card mb-4">
    <div class="card-header"><h4 class="mb-0">Exceptions overview (last 24h)</h4></div>
    <div class="card-body">
        <p class="text-muted">
            A cheap catch-all health probe: every web-job logs unhandled and handled errors into Application Insights, so
            a rising exception count is an early warning of failures no specific check anticipates.
        </p>

        @if (!string.IsNullOrEmpty(Model.ExceptionsError))
        {
            <div class="alert alert-warning">Couldn't load exceptions: @Model.ExceptionsError</div>
        }
        else if (Model.AppInsightsConfigured)
        {
            <p>
                <span class="display-4">@Model.ExceptionsLast24h</span>
                <span class="text-muted">exceptions in the last 24 hours</span>
            </p>

            if (Model.ExceptionsPerHour.Any())
            {
                var maxCount = Model.ExceptionsPerHour.Max(h => h.Count);
                if (maxCount < 1) { maxCount = 1; }
                <h6>Per hour</h6>
                <div style="display:flex; align-items:flex-end; height:90px; gap:2px; border-bottom:1px solid #dee2e6; margin-bottom:1rem;">
                    @foreach (var h in Model.ExceptionsPerHour)
                    {
                        var pct = (int)Math.Round(100.0 * h.Count / maxCount);
                        var title = (h.HourUtc.HasValue ? h.HourUtc.Value.ToString("HH:mm") : "?") + " UTC: " + h.Count;
                        <div title="@title"
                             style="flex:1; min-width:4px; height:@(Math.Max(pct, 2))%; background-color:@(h.Count > 0 ? "#dc3545" : "#e9ecef");"></div>
                    }
                </div>
            }

            <h6>Top exception types</h6>
            if (Model.TopExceptionTypes.Any())
            {
                <table class="table table-sm">
                    <thead><tr><th>Type</th><th>Problem id</th><th class="text-right">Count</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.TopExceptionTypes)
                        {
                            <tr>
                                <td><code>@t.Type</code></td>
                                <td class="text-muted">@t.ProblemId</td>
                                <td class="text-right">@t.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-success">No exceptions recorded in the last 24 hours.</p>
            }
        }
    </div>
</div>

<!-- ===================== Component health ===================== -->
<div class="card mb-4">
    <div class="card-header"><h4 class="mb-0">Component health</h4></div>
    <div class="card-body">
        <p class="text-muted">
            Latest runtime <code>HealthCheck</code> per component (SQL, Activity API, Graph, Key Vault, Redis,
            Service Bus, runtime credential, DNS), including the credential days-to-expiry warning.
        </p>

        @if (!string.IsNullOrEmpty(Model.ComponentHealthError))
        {
            <div class="alert alert-warning">Couldn't load component health: @Model.ComponentHealthError</div>
        }
        else if (Model.AppInsightsConfigured)
        {
            if (Model.ComponentHealth.Any())
            {
                <table class="table table-sm">
                    <thead><tr><th>Component</th><th>Status</th><th>Detail</th><th>Days to expiry</th><th>Last checked</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.ComponentHealth)
                        {
                            <tr>
                                <td>@c.Component</td>
                                <td><span class="badge @StatusBadge(c.Status)">@c.Status</span></td>
                                <td class="text-muted">@c.Detail</td>
                                <td>@(c.DaysToExpiry.HasValue ? c.DaysToExpiry.Value.ToString() : "")</td>
                                <td class="text-muted">@HealthDashboard.HowLongAgo(c.LastSeenUtc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">
                    No <code>HealthCheck</code> telemetry yet. Runtime health checks are emitted by a later phase
                    (the independent-timer heartbeat host that reuses the installer's verifier checks). Until then this
                    card is empty by design - use Import liveness and Exceptions above, which are populated today.
                </div>
            }
        }
    </div>
</div>

<!-- ===================== Data overview (SQL) ===================== -->
<div class="card mb-4">
    <div class="card-header"><h4 class="mb-0">Data overview</h4></div>
    <div class="card-body">
        <p class="text-muted">Row counts and freshness straight from the database.</p>

        @if (!string.IsNullOrEmpty(Model.DataError))
        {
            <div class="alert alert-warning">Couldn't load data overview: @Model.DataError</div>
        }
        else
        {
            <table class="table table-sm" style="max-width:520px;">
                <tbody>
                    <tr><td>Hits</td><td>@Model.HitCount</td></tr>
                    <tr><td>Activity imports (audit events)</td><td>@Model.ActivityCount</td></tr>
                    <tr><td>Teams discovered</td><td>@Model.TeamsCount</td></tr>
                    <tr><td>Teams with tracking enabled</td><td>@Model.TeamsBeingTrackedCount</td></tr>
                    <tr>
                        <td>Newest hit</td>
                        <td>
                            @(Model.NewestHitUtc.HasValue ? Model.NewestHitUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") + " UTC" : "-")
                            <span class="badge @FreshnessBadge(Model.NewestHitUtc, HealthDashboard.CycleSlaHours, HealthDashboard.CycleSlaHours * 2)">@HealthDashboard.HowLongAgo(Model.NewestHitUtc)</span>
                        </td>
                    </tr>
                    <tr>
                        <td>Newest audit event</td>
                        <td>
                            @(Model.NewestAuditEventUtc.HasValue ? Model.NewestAuditEventUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") + " UTC" : "-")
                            <span class="badge @FreshnessBadge(Model.NewestAuditEventUtc, HealthDashboard.CycleSlaHours, HealthDashboard.CycleSlaHours * 2)">@HealthDashboard.HowLongAgo(Model.NewestAuditEventUtc)</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>

<p class="text-muted small">
    To be alerted (not just to look), set up the Azure Monitor / Application Insights alert rules described in the
    <strong>Health Alerts</strong> wiki guide. The same custom events shown here back those alerts.
</p>
