<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<appSettings xdt:Transform="Replace">

		<!-- Settings needed for config classes to work properly -->
		<add key="ChunkSize" value="0.01:00:00" />
		<add key="DaysBeforeNowToDownload" value="6" />

	</appSettings>
	
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      Custom errors on for every caller but this machine. The template ships them Off for local debugging, and
      Off means a remote browser gets the full exception page - type, message, source and stack trace - from any
      MVC or pipeline failure, and Web API's default error policy follows this setting too. Unhandled failures
      still reach Application Insights (WebExceptionTelemetry).
    -->
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />
  </system.web>
</configuration>
