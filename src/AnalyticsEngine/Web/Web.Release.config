<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<appSettings xdt:Transform="Replace">

		<!-- Settings needed for config classes to work properly -->
		<add key="ChunkSize" value="0.01:00:00" />
		<add key="DaysBeforeNowToDownload" value="6" />
		<!-- Copilot Adoption individual-user lists and exports are aggregate-only until this is set
		     to an Entra app-role value or group object id emitted in the signed-in user's token. -->
		<add key="CopilotAdoptionIndividualDataRole" value="" />
		<!-- Set true to turn off Copilot Adoption per-user lists and every export, leaving overview only. -->
		<add key="CopilotAdoptionDisableIndividualData" value="false" />
		<!-- Defaults true when omitted: permitted users see stable pseudonyms unless explicitly disabled. -->
		<add key="CopilotAdoptionPseudonymiseIndividualData" value="true" />

	</appSettings>
	
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      In the example below, the "Replace" transform will replace the entire 
      <customErrors> section of your web.config file.
      Note that because there is only one customErrors section under the 
      <system.web> node, there is no need to use the "xdt:Locator" attribute.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>
