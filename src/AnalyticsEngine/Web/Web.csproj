<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Web.AnalyticsWeb</RootNamespace>
    <AssemblyName>Web.AnalyticsWeb</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs is checked in and carries the product version attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The SHARED solution-wide secrets store, deliberately the same id as Common.Entities. Without
         it, Visual Studio's `Manage User Secrets` mints a fresh random id into this project and opens a
         store that AnalyticsConfig never reads - secrets that appear saved but are silently ignored. -->
    <UserSecretsId>pnp-m365-analytics-insights</UserSecretsId>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0060;CA1416;NU1510</NoWarn>
    <!-- The React portal is built by npm and served as static files; nothing here is a Razor SPA. -->
    <SpaRoot>Scripts\portal\</SpaRoot>
    <NpmInstallStampFile>Scripts/portal/node_modules/.install-stamp</NpmInstallStampFile>
    <SpaBuildOutputFile>$(SpaRoot)build\index.html</SpaBuildOutputFile>
  </PropertyGroup>

  <!-- The SPA sources are not compiled by MSBuild; excluding them keeps the default globs off
       node_modules, which otherwise makes every build enumerate tens of thousands of files. -->
  <ItemGroup>
    <Compile Remove="$(SpaRoot)**" />
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)node_modules\**" />
    <EmbeddedResource Remove="$(SpaRoot)**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.EntityFramework.SqlServer" Version="6.5.2" />
    <!-- 4.0.0, not 3.16.0: that version was never published, so NuGet silently resolved up to 4.0.0
         and warned (NU1603). Pinning what is actually used makes the build reproducible - a floating
         resolution is one package publish away from changing the auth stack underneath us. -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <!-- Controllers serialise with Newtonsoft configured as Web API 2 was, not System.Text.Json:
         the shared models' [JsonProperty]/[JsonIgnore] attributes ARE the portal's wire contract.
         See WebApiCompatibleJson. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="System.ClientModel" Version="1.15.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Graph.Core" Version="4.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.11" />
    <PackageReference Include="System.Memory.Data" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.11" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.ControlPanel.Engine\App.ControlPanel.Engine.csproj" />
    <ProjectReference Include="..\Common\DataUtils\DataUtils.csproj" />
    <ProjectReference Include="..\Common\Entities\Entities.csproj" />
    <ProjectReference Include="..\WebJob.Office365ActivityImporter.Engine\WebJob.Office365ActivityImporter.Engine.csproj" />
  </ItemGroup>

  <!-- Node version guard, shared with the other npm consumers in the repo. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\NodeVersion.targets" />

  <ItemGroup>
    <SpaSourceFile Include="$(SpaRoot)src\**\*" />
    <SpaSourceFile Include="$(SpaRoot)public\**\*" />
    <Content Include="Scripts\portal\src\test\tsconfig.json" />
    <SpaSourceFile Include="$(SpaRoot)index.html" />
    <SpaSourceFile Include="$(SpaRoot)vite.config.ts" />
    <SpaSourceFile Include="$(SpaRoot)tsconfig.json" />
  </ItemGroup>

  <!-- CheckNodeVersion is a DependsOnTargets rather than a step inside the body on purpose: MSBuild
       resolves dependencies BEFORE the Inputs/Outputs up-to-date check, so the guard still runs on an
       incremental build where node_modules is already current. -->
  <Target Name="NpmInstall" DependsOnTargets="CheckNodeVersion" Inputs="$(SpaRoot)package.json;$(SpaRoot)package-lock.json" Outputs="$(NpmInstallStampFile)">
    <Message Importance="high" Text="Restoring portal dependencies using 'npm'. This may take several minutes..." />
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" />
    <Touch Files="$(NpmInstallStampFile)" AlwaysCreate="true" />
  </Target>

  <Target Name="NpmBuildSpa" DependsOnTargets="NpmInstall" Inputs="@(SpaSourceFile)" Outputs="$(SpaBuildOutputFile)">
    <Message Importance="high" Text="Building the portal SPA with 'npm run build'..." />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!-- The built bundle is served by UseStaticFiles from wwwroot. It is copied there rather than
       declared as Content with a Link: ASP.NET Core's static web asset pipeline derives each asset's
       route from its item spec, and linked items outside the project cone all collapse onto the same
       route, which it rejects as a duplicate. A plain copy sidesteps that entirely. -->
  <Target Name="IncludeSpaBuildOutput" AfterTargets="NpmBuildSpa" DependsOnTargets="NpmBuildSpa" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <SpaBuiltFile Include="$(SpaRoot)build\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaBuiltFile)" DestinationFiles="@(SpaBuiltFile->'wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Configuration is appsettings.json plus environment variables (and user secrets in
       Development); see AnalyticsConfig. The Sdk.Web default already copies appsettings*.json. -->

</Project>