<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Tests.UnitTests</RootNamespace>
    <AssemblyName>Tests.UnitTests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs is checked in and carries the product version attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Obsolete-crypto and Windows-only warnings are tracked separately; silencing them here
         keeps the framework move readable rather than hiding anything new. -->
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0060;CA1416;NU1510</NoWarn>
    <IsPackable>false</IsPackable>
    <!-- A linked Tests.FakeDataGen file carries its own Main; MSTest would add a second. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.TextAnalytics" Version="5.3.0" />
    <PackageReference Include="Azure.Core" Version="1.62.0" />
    <PackageReference Include="System.ClientModel" Version="1.15.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" Version="4.9.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.EntityFramework.SqlServer" Version="6.5.2" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi" Version="5.3.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.11" />
    <PackageReference Include="System.Memory.Data" Version="10.0.11" />
    <PackageReference Include="System.Runtime" Version="4.3.1" />
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.ControlPanel.Engine\App.ControlPanel.Engine.csproj" />
    <ProjectReference Include="..\Common\CloudInstallEngine\CloudInstallEngine.csproj" />
    <ProjectReference Include="..\Common\DataUtils\DataUtils.csproj" />
    <ProjectReference Include="..\Common\Entities\Entities.csproj" />
    <ProjectReference Include="..\Common\UsageReporting\UsageReporting.csproj" />
    <ProjectReference Include="..\WebJob.AppInsightsImporter.Engine\WebJob.AppInsightsImporter.Engine.csproj" />
    <ProjectReference Include="..\WebJob.Office365ActivityImporter.Engine\WebJob.Office365ActivityImporter.Engine.csproj" />
    <ProjectReference Include="..\Web\Web.csproj">
      <!-- The tests reference Web types through the AnalyticsWeb:: extern alias to avoid a clash with the Web namespace. -->
      <Aliases>AnalyticsWeb</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <!-- Source linked from Tests.FakeDataGen. A ProjectReference is not possible: FakeDataGen
       references this project, so linking the files is how the cycle is avoided. -->
  <ItemGroup>
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoAgentCosts.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoAreas.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoCalendar.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoCommand.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoGenerator.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoInteractive.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoOptions.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoPopulation.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoPortalReadiness.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoTables.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoCollaborationTables.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoCollaborationGenerator.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoPowerPlatformTables.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoPowerPlatformGenerator.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\DemoTimeline.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\SqlDemoDatabase.cs" />
    <Compile Include="..\Tests.FakeDataGen\Demo\SqlExistingDemoDatabase.cs" />
    <Compile Include="..\Tests.FakeDataGen\Copilot\CopilotAdoptionPersonas.cs" />
    <Compile Include="..\Tests.FakeDataGen\Seeding\SeedDataCatalogue.cs" />
  </ItemGroup>

  <!-- Configuration comes from appsettings.json plus environment variables (and user secrets
       in Development); see AnalyticsConfig. Copied next to the binary because that is where
       AnalyticsConfig sets its base path. -->
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
