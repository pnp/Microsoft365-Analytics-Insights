<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Common.Entities</RootNamespace>
    <AssemblyName>Common.Entities</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs is checked in and carries the product's version attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The solution-wide developer secrets store. This property is what `dotnet user-secrets` reads
         to find the store; the RUNTIME reads the matching [assembly: UserSecretsId] in
         Properties\AssemblyInfo.cs. Both are needed and must agree, because GenerateAssemblyInfo is
         false here, so setting this property alone emits no attribute and the store is silently
         unreadable at run time. ConfigurationSourceTests guards the attribute. -->
    <UserSecretsId>pnp-m365-analytics-insights</UserSecretsId>
    <!-- The obsolete crypto and Windows-only DPAPI warnings are tracked separately; they are not
         actionable during the framework move and would otherwise drown the real output. -->
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0060;CA1416;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lives outside the project directory, so it is not picked up by the default glob. Its manifest
         name (Common.Entities.Clean Old Data Data.sql) is loaded by exact string at runtime and is
         pinned by EmbeddedResourceNameTests - do not "tidy" this into a Link. -->
    <EmbeddedResource Include="..\..\..\Clean Old Data Data.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.62.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="BCrypt.Net-Next.StrongName" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <!-- Loaded reflectively by AnalyticsConfig, and only in the Development environment. Referenced
         here so the assembly is actually present to be found; without it the user-secrets source that
         replaced the old gitignored App.Debug.config silently does nothing. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.EntityFramework.SqlServer" Version="6.5.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="6.0.2" />
    <PackageReference Include="Microsoft.NETCore.Targets" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.11" />
    <PackageReference Include="System.Memory.Data" Version="10.0.11" />
    <PackageReference Include="System.Runtime" Version="4.3.1" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataUtils\DataUtils.csproj" />
  </ItemGroup>

</Project>