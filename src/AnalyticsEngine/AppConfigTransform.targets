<Project>

  <!--
    Generates App.config from App.Template.config plus the per-configuration transform, which is the
    repo convention: App.Template.config is the source of truth and App.config is a build output.

    The legacy projects did this with the TransformXml task from Microsoft.WebApplication.targets.
    That task ships with Visual Studio's web tooling and is not available to `dotnet build`, so an
    SDK-style project cannot use it without tying the build to a VS install.

    Two attempts at a task-based replacement both failed on task RESOLUTION rather than on the
    transform itself: a RoslynCodeTaskFactory inline task compiled locally on SDK 10.0.400 but not on
    a CI runner with 10.0.401, and SlowCheetah's TransformXml did not resolve either. Both are the
    same class of problem - a custom task has to be found and loaded before it can run, and that is
    the fragile part.

    So this drives the transform through Exec instead. Exec is a built-in MSBuild task, so there is
    nothing to resolve; the XDT engine itself comes from the restored Microsoft.Web.Xdt package,
    which is the same library TransformXml wraps. The branch is Windows-only (net10.0-windows), so
    Windows PowerShell is a safe host.

    Projects opt in by setting <GenerateAppConfigFromTemplate>true</GenerateAppConfigFromTemplate>.
  -->

  <ItemGroup Condition="'$(GenerateAppConfigFromTemplate)' == 'true'">
    <PackageReference Include="Microsoft.Web.Xdt" Version="3.1.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Skips when the per-configuration transform is absent: App.Debug.config is developer-local and
    gitignored, so a clean clone or a CI agent legitimately has no Debug transform to apply. Without
    this guard the build fails on a machine that simply has not been set up for local debugging.
  -->
  <Target Name="GenerateAppConfig"
          BeforeTargets="PrepareForBuild;BeforeBuild"
          Condition="'$(GenerateAppConfigFromTemplate)' == 'true' AND Exists('App.$(Configuration).config')"
          Inputs="App.Template.config;App.$(Configuration).config"
          Outputs="App.config">

    <PropertyGroup>
      <_XdtAssembly>$(NuGetPackageRoot)microsoft.web.xdt\3.1.0\lib\netstandard2.0\Microsoft.Web.XmlTransform.dll</_XdtAssembly>
      <!-- Single-quoted inside the PowerShell command so MSBuild's own $ escaping stays readable. -->
      <_XdtScript>
        Add-Type -Path '$(_XdtAssembly)';
        $doc = New-Object Microsoft.Web.XmlTransform.XmlTransformableDocument;
        $doc.PreserveWhitespace = $true;
        $doc.Load('App.Template.config');
        $xfm = New-Object Microsoft.Web.XmlTransform.XmlTransformation('App.$(Configuration).config');
        if (-not $xfm.Apply($doc)) { Write-Error 'XDT transform failed.'; exit 1 };
        $doc.Save('App.config');
      </_XdtScript>
    </PropertyGroup>

    <Error Condition="!Exists('$(_XdtAssembly)')"
           Text="Microsoft.Web.Xdt was not restored, so App.config cannot be generated from App.Template.config. Run a restore first." />

    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$(_XdtScript.Replace('%0A',' ').Replace('%0D',' '))&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low" />

    <Message Importance="normal"
             Text="Generated App.config from App.Template.config + App.$(Configuration).config" />
  </Target>

</Project>
